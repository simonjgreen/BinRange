/* Candidate 512-KiB layout; verifier must approve artifacts before flashing. */
/ {
    chosen { zephyr,code-partition = &slot0_partition; };
    aliases { sw0 = &tag_key; };
    buttons {
        compatible = "gpio-keys";
        tag_key: key { gpios = <&gpio0 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
    };
};
&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;
        boot_partition: partition@0 {
            label = "mcuboot";
            reg = <0x0 0x10000>;
        };
        slot0_partition: partition@10000 {
            label = "image-0";
            reg = <0x10000 0x35000>;
        };
        slot1_partition: partition@45000 {
            label = "image-1";
            reg = <0x45000 0x36000>;
        };
        storage_partition: partition@7b000 {
            label = "storage";
            reg = <0x7b000 0x5000>;
        };
    };
};
